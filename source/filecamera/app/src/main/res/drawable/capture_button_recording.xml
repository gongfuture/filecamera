<?xml version="1.0" encoding="utf-8"?>
<!-- 录像进行中：红色外环 + 红色圆角方块（停止） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="3dp"
                        android:color="#E8616F" />
                </shape>
            </item>
            <item
                android:bottom="23dp"
                android:left="23dp"
                android:right="23dp"
                android:top="23dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E8616F" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/cam_danger" />
                </shape>
            </item>
            <item
                android:bottom="23dp"
                android:left="23dp"
                android:right="23dp"
                android:top="23dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cam_danger" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
