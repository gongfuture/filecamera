# 历史版本 - 通过 Gitee Release 管理
历史版本/

# APK 安装包（历史版本通过 Gitee Release 管理，最新版保留在根目录方便下载）
*.apk
!巡查相机v*.apk

# 版本标记文件
source/*.version

# 根目录 IDE 配置（本机状态，不入库）
/.idea/

# 定制版本地私有默认配置/图标（不入 Gitee）
source/filecamera/app/src/main/assets/config/custom_config.json
source/filecamera/app/src/main/assets/config/config_source.local.txt
source/filecamera/app/src/main/assets/custom_icon.png
